# Kike Code's backend is PLW's Supabase project (sign-in, saved sites, AI,
# greeting audio, contact-form leads). Same two values as PLW's .env —
# Supabase Dashboard -> Project Settings -> API. Public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Legacy Express API (artifacts/api-server), still what the Replit deployment
# runs until it is retired. The web app no longer calls it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=replace-with-a-long-random-secret
ACCESS_PIN=replace-with-private-operator-pin
API_PORT=8080
WEB_PORT=5173
BASE_PATH=/
LOG_LEVEL=info

# Anthropic (direct API recommended outside Replit)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# OpenAI (direct API recommended outside Replit)
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Legacy Replit AI integration names remain supported as fallbacks during migration:
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=
